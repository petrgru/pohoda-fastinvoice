# Copy to k8s/k3s.env (gitignored) and adjust, or run scripts/k3s/setup-env.sh
# to generate it with fresh random secrets.

# --- cluster placement -------------------------------------------------------
K3S_NS=fastinvoice
# where the app points users/CORS: the node IP servicelb assigns to the
# backend Service (see scripts/k3s/status.sh); same-origin so no CORS issues
FRONTEND_HOST=http://192.168.22.100
# optional registry; empty = build a tar and `k3s ctr images import` on the node
REGISTRY=
IMAGE_TAG=dev

# --- application -------------------------------------------------------------
PROJECT_NAME="Pohoda FastInvoice"
SECRET_KEY=change-me
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=change-me
SENTRY_DSN=

# --- postgres (StatefulSet db) -----------------------------------------------
POSTGRES_PASSWORD=change-me

# --- meilisearch ---------------------------------------------------------------
MEILISEARCH_ENABLED=true
MEILISEARCH_MASTER_KEY=change-me

# --- smtp (empty SMTP_HOST disables outbound mail) ----------------------------
# point SMTP_HOST at a real relay; the compose-only adminer/mailpit pair is
# deliberately not ported to k3s
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=

# --- parsing / LLM --------------------------------------------------------------
# k3s pods reach the LAN cluster through normal pod egress (Flannel SNAT)
QUEUE_MODE=queue
LLM_BASE_URL=http://192.168.22.154:18300/v1
LLM_MODEL=qwen3.8-flash-next
LLM_VISION_MODEL=

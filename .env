# Enable development behavior for commands that import the app directly
FASTAPI_ENV=development

PROJECT_NAME="Pohoda FastInvoice"

SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Emails
SMTP_HOST=localhost
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=False
SMTP_PORT=1025

# Postgres
POSTGRES_PASSWORD=changethis
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/app

# Invoices – storage (local for development, s3 for production)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage/invoices
# S3_BUCKET=
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Invoices – parsing via OpenAI-compatible LLM API (local server)
LLM_BASE_URL=http://192.168.22.154:18300/v1
LLM_API_KEY=
LLM_MODEL=qwen3.8-flash-next
# LLM_VISION_MODEL=  # defaults to LLM_MODEL

# Export API for the Pohoda connector (empty = endpoints disabled)
EXPORT_API_KEY=e2e-export-key

# Meilisearch full-text search (docker run -p 7700:7700 ...)
MEILISEARCH_MASTER_KEY=fastinvoice-meili-dev-key

# Development-only features (cascade deletes) – never in production
DEVELOP=yes
